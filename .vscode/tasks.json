{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build All",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": "CMake: Configure"
        },
        {
            "label": "CMake: Build mkobmafs",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "mkobmafs"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Build mount.obmafs",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "mount.obmafs"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Build obmafsck",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "obmafsck"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Build import-aif",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "import-aif"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Test: Create and check FS",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "${workspaceFolder}/build/src/mkobmafs/mkobmafs -s 10485760 -l TestFS /tmp/test.obmafs && ${workspaceFolder}/build/src/obmafsck/obmafsck /tmp/test.obmafs"
            ],
            "group": "test",
            "problemMatcher": [],
            "dependsOn": "CMake: Build All"
        }
    ]
}
